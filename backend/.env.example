# SPL 2026 Player Registration System Configuration

# Server Port (auto-assigned by Render/Vercel)
PORT=3000

# Admin Dashboard Credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin_spl_2026

# Express Session Secret
SESSION_SECRET=spl_2026_super_secret_session_key

# Razorpay API Credentials
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Payment Mode (Set true for developer mock testing without real money, false for live Razorpay)
USE_MOCK_PAYMENT=true

# Database Configuration (XAMPP Local or Aiven Cloud MySQL)
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=spl_2026
DB_PORT=3306

# Set DB_SSL=true when connecting to cloud MySQL providers like Aiven
DB_SSL=false
